<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f5f5;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding: 20px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .header h1 {
            font-size: 28px;
            color: #2c3e50;
        }

        .btn-logout {
            background: #e74c3c;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.3s;
        }

        .btn-logout:hover {
            background: #c0392b;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .card h2 {
            font-size: 20px;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            color: #2c3e50;
            font-size: 14px;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #bdc3c7;
            border-radius: 5px;
            font-size: 14px;
            font-family: inherit;
            transition: border-color 0.3s;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #3498db;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
        }

        .form-group small {
            display: block;
            margin-top: 5px;
            color: #95a5a6;
            font-size: 12px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 25px;
        }

        .btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-primary {
            background: #3498db;
            color: white;
        }

        .btn-primary:hover {
            background: #2980b9;
        }

        .btn-danger {
            background: #e74c3c;
            color: white;
        }

        .btn-danger:hover {
            background: #c0392b;
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 12px;
        }

        .services-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .service-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: #f9f9f9;
            border-left: 4px solid #3498db;
            border-radius: 4px;
            transition: all 0.3s;
        }

        .service-item:hover {
            background: #f0f7ff;
            transform: translateX(5px);
        }

        .service-info {
            flex: 1;
        }

        .service-name {
            font-weight: 600;
            color: #2c3e50;
            font-size: 16px;
        }

        .service-slug {
            font-size: 12px;
            color: #95a5a6;
            margin-top: 3px;
        }

        .service-margin {
            background: #e8f8f5;
            color: #27ae60;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin: 0 15px;
        }

        .service-actions {
            display: flex;
            gap: 8px;
        }

        .alert {
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 400px;
        }

        .toast {
            padding: 14px 18px;
            border-radius: 6px;
            font-size: 14px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
            animation: slideInRight 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 44px;
        }

        .toast-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .toast-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .toast-info {
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        .toast-icon {
            font-size: 16px;
            flex-shrink: 0;
        }

        .toast-message {
            flex: 1;
            word-break: break-word;
        }

        .toast-close {
            background: none;
            border: none;
            color: inherit;
            cursor: pointer;
            font-size: 18px;
            padding: 0;
            flex-shrink: 0;
        }

        @keyframes slideInRight {
            from {
                transform: translateX(400px);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes slideOutRight {
            from {
                transform: translateX(0);
                opacity: 1;
            }

            to {
                transform: translateX(400px);
                opacity: 0;
            }
        }

        .toast.removing {
            animation: slideOutRight 0.3s ease forwards;
        }
    </style>
</head>

<body>
    <div class="container">

        <%- include('_taskbar', { currentTab: 'services' }) %>

            <div class="content-grid">
                <!-- Form Section -->
                <div class="card">
                    <h2>➕ Add/Edit Service</h2>
                    <form id="serviceForm">
                        <div class="form-group">
                            <label for="serviceName">Service Name *</label>
                            <input type="text" id="serviceName" name="name" placeholder="e.g., WEB, DNS, MAIL" required>
                            <small>Tên dịch vụ</small>
                        </div>

                        <div class="form-group">
                            <label for="serviceSlug">Service Slug *</label>
                            <input type="text" id="serviceSlug" name="slug"
                                placeholder="e.g., web, dns-service, mail-srv" required>
                            <small>URL-friendly identifier (letters, numbers, hyphens, underscores only)</small>
                        </div>

                        <div class="form-group">
                            <label for="serviceMargin">Margin *</label>
                            <input type="number" id="serviceMargin" name="margin" placeholder="0.00" step="0.01" min="0"
                                required>
                            <small>Điểm margin (ví dụ: 10.5)</small>
                        </div>

                        <div class="button-group">
                            <button type="submit" class="btn btn-primary">💾 Save Service</button>
                            <button type="reset" class="btn btn-danger">🔄 Clear Form</button>
                        </div>
                    </form>
                </div>

                <!-- Services List Section -->
                <div class="card">
                    <h2>📋 All Services</h2>
                    <div id="servicesList" class="services-list">
                        <div style="text-align: center; padding: 40px 20px; color: #95a5a6;">
                            <div style="font-size: 40px; margin-bottom: 10px;">📭</div>
                            <p>No services yet</p>
                            <p style="font-size: 12px; margin-top: 10px;">Create one using the form on the left
                            </p>
                        </div>
                    </div>
                </div>
            </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container"></div>

    <script>
        // Toast notification function
        function showToast(message, type = 'info', duration = 5000) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;

            let icon = 'ℹ️';
            if (type === 'success') icon = '✓';
            if (type === 'error') icon = '❌';

            toast.innerHTML = `
                <span class="toast-icon">${icon}</span>
                <div class="toast-message">${message}</div>
                <button class="toast-close" onclick="this.parentElement.remove();">✕</button>
            `;

            container.appendChild(toast);

            if (duration > 0) {
                setTimeout(() => {
                    if (toast.parentElement) {
                        toast.classList.add('removing');
                        setTimeout(() => toast.remove(), 300);
                    }
                }, duration);
            }
        }

        // Load all services
        async function loadServices() {
            try {
                const response = await fetch('/admin/services-data');
                const result = await response.json();

                if (result.success && result.data.length > 0) {
                    renderServices(result.data);
                } else {
                    document.getElementById('servicesList').innerHTML = `
                        <div style="text-align: center; padding: 40px 20px; color: #95a5a6;">
                            <div style="font-size: 40px; margin-bottom: 10px;">📭</div>
                            <p>No services yet</p>
                            <p style="font-size: 12px; margin-top: 10px;">Create one using the form on the left</p>
                        </div>
                    `;
                }
            } catch (error) {
                showToast('Failed to load services: ' + error.message, 'error', 6000);
            }
        }

        // Render services list
        function renderServices(services) {
            const container = document.getElementById('servicesList');
            container.innerHTML = services.map(service => `
                <div class="service-item">
                    <div class="service-info">
                        <div class="service-name">${service.name}</div>
                        <div class="service-slug">@${service.slug}</div>
                    </div>
                    <div class="service-margin">${parseFloat(service.margin).toFixed(2)}</div>
                    <div class="service-actions">
                        <button class="btn btn-primary btn-sm" onclick="editService(${service.id})">✏️ Edit</button>
                        <button class="btn btn-danger btn-sm" onclick="deleteService(${service.id})">🗑️ Delete</button>
                    </div>
                </div>
            `).join('');
        }

        // Edit service
        async function editService(id) {
            try {
                const response = await fetch(`/admin/services-data`);
                const result = await response.json();
                const service = result.data.find(s => s.id == id);

                if (service) {
                    document.getElementById('serviceName').value = service.name;
                    document.getElementById('serviceSlug').value = service.slug;
                    document.getElementById('serviceMargin').value = service.margin;
                    document.getElementById('serviceForm').dataset.editId = id;

                    // Scroll to form
                    document.querySelector('.card').scrollIntoView({ behavior: 'smooth' });
                }
            } catch (error) {
                showToast('Failed to load service: ' + error.message, 'error', 6000);
            }
        }

        // Form submission
        document.getElementById('serviceForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const editId = this.dataset.editId;
            const formData = {
                name: document.getElementById('serviceName').value.trim(),
                slug: document.getElementById('serviceSlug').value.trim(),
                margin: document.getElementById('serviceMargin').value.trim()
            };

            // Validation
            const errors = [];
            if (!formData.name) errors.push('Service name is required');
            if (!formData.slug) errors.push('Service slug is required');
            if (!formData.margin || isNaN(parseFloat(formData.margin))) errors.push('Margin must be a valid number');

            if (errors.length > 0) {
                errors.forEach(error => showToast(error, 'error', 6000));
                return;
            }

            try {
                const method = editId ? 'PUT' : 'POST';
                const url = editId ? `/admin/services-data/${editId}` : '/admin/services-data';

                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();

                if (result.success) {
                    showToast(
                        editId ? '✓ Service updated successfully!' : '✓ Service created successfully!',
                        'success',
                        2000
                    );
                    document.getElementById('serviceForm').reset();
                    delete this.dataset.editId;
                    setTimeout(() => loadServices(), 500);
                } else {
                    result.errors.forEach(error => showToast(error, 'error', 6000));
                }
            } catch (error) {
                showToast('Network error: ' + error.message, 'error', 6000);
            }
        });

        // Delete service
        async function deleteService(id) {
            if (!confirm('Are you sure you want to delete this service?')) return;

            try {
                const response = await fetch(`/admin/services-data/${id}`, {
                    method: 'DELETE'
                });

                const result = await response.json();

                if (result.success) {
                    showToast('✓ Service deleted successfully!', 'success', 2000);
                    setTimeout(() => loadServices(), 500);
                } else {
                    result.errors.forEach(error => showToast(error, 'error', 6000));
                }
            } catch (error) {
                showToast('Failed to delete service: ' + error.message, 'error', 6000);
            }
        }

        // Logout
        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                window.location.href = '/admin/logout';
            }
        }

        // Load services on page load
        loadServices();
    </script>
</body>

</html>