<%- include('../layout') %>

    <div class="team-detail">
        <a href="/admin/teams">← Back to Teams</a>

        <h2>Team Details</h2>

        <div class="detail-card">
            <h3>
                <%= team.name %>
            </h3>
            <dl>
                <dt>ID:</dt>
                <dd>
                    <%= team.id %>
                </dd>

                <dt>Team Key:</dt>
                <dd><code><%= team.teamKey %></code></dd>

                <dt>Country:</dt>
                <dd>
                    <%= team.country || 'N/A' %>
                </dd>

                <dt>Education:</dt>
                <dd>
                    <%= team.education || 'N/A' %>
                </dd>

                <dt>Max Members:</dt>
                <dd>
                    <%= team.maxMembers %>
                </dd>

                <dt>Status:</dt>
                <dd><span class="<%= team.isActive ? 'badge-active' : 'badge-inactive' %>">
                        <%= team.isActive ? 'Active' : 'Inactive' %>
                    </span></dd>

                <dt>Created:</dt>
                <dd>
                    <%= new Date(team.createdAt).toLocaleString() %>
                </dd>
            </dl>
        </div>

        <div class="detail-card">
            <h3>Members (<%= members.length %>)</h3>
            <% if (members.length> 0) { %>
                <ul class="member-list">
                    <% members.forEach(member=> { %>
                        <li>
                            <a href="/admin/users/<%= member.id %>">
                                <%= member.username %>
                            </a>
                            (<%= member.email %>)
                        </li>
                        <% }); %>
                </ul>
                <% } else { %>
                    <p>No members</p>
                    <% } %>
        </div>

        <div class="detail-card">
            <h3>VPN Configurations (<%= vpnConfigs.length %>)</h3>
            <% if (vpnConfigs.length> 0) { %>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>IP</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% vpnConfigs.forEach(config=> { %>
                            <tr>
                                <td>
                                    <%= config.nameVpn %>
                                </td>
                                <td><span class="<%= config.typeVpn ? 'badge-true' : 'badge-false' %>">
                                        <%= config.typeVpn ? 'Type 1' : 'Type 2' %>
                                    </span></td>
                                <td>
                                    <%= config.ipVpn || 'N/A' %>
                                </td>
                                <td>
                                    <%= config.statusVpn || 'N/A' %>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
                <% } else { %>
                    <p>No VPN configurations</p>
                    <% } %>
        </div>
    </div>

    <style>
        .team-detail {
            max-width: 800px;
        }

        .team-detail a {
            color: #3498db;
            text-decoration: none;
            margin-bottom: 20px;
            display: inline-block;
        }

        .detail-card {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }

        .detail-card h3 {
            margin-bottom: 20px;
            color: #2c3e50;
        }

        .detail-card dl {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 15px;
        }

        .detail-card dt {
            font-weight: 600;
            color: #2c3e50;
        }

        .detail-card dd {
            color: #7f8c8d;
        }

        code {
            background: #ecf0f1;
            padding: 4px 8px;
            border-radius: 4px;
            font-family: monospace;
        }

        .member-list {
            list-style: none;
            padding: 0;
        }

        .member-list li {
            padding: 10px;
            border-bottom: 1px solid #ecf0f1;
        }

        .member-list a {
            color: #3498db;
            text-decoration: none;
        }

        .member-list a:hover {
            text-decoration: underline;
        }

        .badge-active {
            background: #d5f4e6;
            color: #27ae60;
            padding: 4px 8px;
            border-radius: 4px;
        }

        .badge-inactive {
            background: #fadbd8;
            color: #c0392b;
            padding: 4px 8px;
            border-radius: 4px;
        }

        .badge-true {
            background: #d6eaf8;
            color: #2980b9;
            padding: 4px 8px;
            border-radius: 4px;
        }

        .badge-false {
            background: #fadbd8;
            color: #c0392b;
            padding: 4px 8px;
            border-radius: 4px;
        }
    </style>