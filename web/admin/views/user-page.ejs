<div class="dashboard">
    <%- include('_taskbar', { currentTab: 'user' }) %>

        <div class="section-header enhanced">
            <div class="header-content">
                <div class="header-icon pro-icon user-icon">USR</div>
                <div class="header-text">
                    <h2>Users Management</h2>
                    <p class="section-subtitle">View and manage system users</p>
                </div>
            </div>
            <div class="header-divider"></div>
        </div>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
            <% } %>

                <div class="dashboard-section">
                    <% if (users && users.length> 0) { %>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>User ID</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Team</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(user=> { %>
                                    <tr>
                                        <td>
                                            <%= user.id %>
                                        </td>
                                        <td>
                                            <%= user.username %>
                                        </td>
                                        <td>
                                            <%= user.email || 'N/A' %>
                                        </td>
                                        <td>
                                            <%= user.teamName || 'N/A' %>
                                        </td>
                                        <td><a href="#">View</a> | <a href="#">Edit</a></td>
                                    </tr>
                                    <% }); %>
                            </tbody>
                        </table>
                        <% } else { %>
                            <p>No users found.</p>
                            <% } %>
                </div>
</div>