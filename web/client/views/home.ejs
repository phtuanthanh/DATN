                                <div class="fact-card">
                                    <div class="fact-icon">👥</div>
                                    <h3>Đội chơi</h3>
                                    <p>28 đội tham gia<br>~ 120 người chơi</p>
                                </div>
                                <div class="fact-card">
                                    <div class="fact-icon">🎯</div>
                                    <h3>Format</h3>
                                    <p>Attack-Defense CTF<br>Tấn công & Phòng chống</p>
                                </div>
                                <div class="fact-card">
                                    <div class="fact-icon">🏆</div>
                                    <h3>Giải thưởng</h3>
