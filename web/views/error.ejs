<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oops! Error</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1a2942 50%, #0f1729 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .animated-bg {
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: -1;
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.08;
            animation: blob-animation 10s infinite;
        }

        .blob-1 {
            width: 400px;
            height: 400px;
            background: linear-gradient(135deg, #00d4ff, #6366f1);
            top: -100px;
            left: -100px;
            animation-delay: 0s;
        }

        .blob-2 {
            width: 300px;
            height: 300px;
            background: linear-gradient(135deg, #ec4899, #8b5cf6);
            bottom: -50px;
            right: -50px;
            animation-delay: 2s;
        }

        @keyframes blob-animation {

            0%,
            100% {
                transform: translate(0, 0) scale(1);
            }

            25% {
                transform: translate(30px, -50px) scale(1.1);
            }

            50% {
                transform: translate(-20px, 20px) scale(0.9);
            }

            75% {
                transform: translate(50px, 50px) scale(1.05);
            }
        }

        .container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            z-index: 10;
            padding: 40px 20px;
        }

        .error-code {
            font-size: clamp(4rem, 20vw, 10rem);
            font-weight: 900;
            margin-top: 1rem;
            margin-bottom: 2rem;
            position: relative;
            display: block;
            line-height: 1;
        }

        /* Glitch effect on error code */
        .error-code {
            color: #00d4ff;
            text-shadow: -2px 0 #ec4899, 2px 0 #6366f1;
            animation: glitch-code 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) 2s infinite;
        }

        @keyframes glitch-code {
            0% {
                text-shadow: -2px 0 #ec4899, 2px 0 #6366f1;
                transform: translate(0);
            }

            20% {
                text-shadow: -2px 0 #ec4899, 2px 0 #6366f1;
                transform: translate(-2px, 2px);
            }

            40% {
                text-shadow: -2px 0 #6366f1, 2px 0 #ec4899;
                transform: translate(-2px, -2px);
            }

            60% {
                text-shadow: -2px 0 #ec4899, 2px 0 #6366f1;
                transform: translate(2px, 2px);
            }

            80% {
                text-shadow: -2px 0 #6366f1, 2px 0 #ec4899;
                transform: translate(2px, -2px);
            }

            100% {
                text-shadow: -2px 0 #ec4899, 2px 0 #6366f1;
                transform: translate(0);
            }
        }

        .error-title {
            font-size: clamp(1.5rem, 4vw, 2.5rem);
            color: #f1f5f9;
            margin-bottom: 1.5rem;
            margin-top: 0;
            animation: fadeInDown 0.8s ease-out;
        }

        .error-message {
            font-size: clamp(0.95rem, 2vw, 1.1rem);
            color: #cbd5e1;
            margin-bottom: 2.5rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.7;
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }

        /* Glitch text effect on message */
        .glitch-text {
            position: relative;
            display: inline-block;
            color: #00d4ff;
        }

        .glitch-text::before,
        .glitch-text::after {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
        }

        .glitch-text::before {
            animation: glitch-animation1 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) 3s infinite;
            background: rgba(0, 212, 255, 0.8);
            color: #00d4ff;
            z-index: -1;
        }

        .glitch-text::after {
            animation: glitch-animation2 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) 3s infinite;
            background: rgba(236, 72, 153, 0.8);
            color: #ec4899;
            z-index: -2;
        }

        @keyframes glitch-animation1 {
            0% {
                clip-path: inset(0 0 65% 0);
                transform: translate(0);
            }

            20% {
                clip-path: inset(0 0 58% 0);
                transform: translate(-2px, 2px);
            }

            40% {
                clip-path: inset(0 0 66% 0);
                transform: translate(-2px, -2px);
            }

            60% {
                clip-path: inset(0 0 61% 0);
                transform: translate(2px, 2px);
            }

            80% {
                clip-path: inset(0 0 59% 0);
                transform: translate(2px, -2px);
            }

            100% {
                clip-path: inset(0 0 60% 0);
                transform: translate(0);
            }
        }

        @keyframes glitch-animation2 {
            0% {
                clip-path: inset(35% 0 0 0);
                transform: translate(0);
            }

            20% {
                clip-path: inset(46% 0 0 0);
                transform: translate(2px, -2px);
            }

            40% {
                clip-path: inset(33% 0 0 0);
                transform: translate(2px, 2px);
            }

            60% {
                clip-path: inset(58% 0 0 0);
                transform: translate(-2px, -2px);
            }

            80% {
                clip-path: inset(27% 0 0 0);
                transform: translate(-2px, 2px);
            }

            100% {
                clip-path: inset(58% 0 0 0);
                transform: translate(0);
            }
        }

        .button-group {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            animation: fadeInUp 0.8s ease-out 0.4s both;
        }

        a {
            padding: 0.9rem 2rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-block;
            border: none;
            cursor: pointer;
            font-size: 1rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, #00d4ff, #0098cc);
            color: #0f172a;
            box-shadow: 0 10px 30px rgba(0, 217, 255, 0.25);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 50px rgba(0, 217, 255, 0.35), 0 0 20px rgba(99, 102, 241, 0.2);
        }

        .btn-secondary {
            background: transparent;
            color: #f1f5f9;
            border: 2px solid #6366f1;
        }

        .btn-secondary:hover {
            background: rgba(99, 102, 241, 0.12);
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(99, 102, 241, 0.2);
        }

        /* Floating animation */
        .floating-icon {
            font-size: 6rem;
            margin-bottom: 2rem;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        /* Fade animations */
        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Scanline effect */
        .scanlines {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 5;
            opacity: 0.03;
            background: repeating-linear-gradient(0deg,
                    transparent,
                    transparent 2px,
                    #fff 2px,
                    #fff 4px);
            animation: scanline-move 0.2s linear infinite;
        }

        @keyframes scanline-move {
            0% {
                transform: translateY(0);
            }

            100% {
                transform: translateY(10px);
            }
        }

        @media (max-width: 768px) {
            .error-code {
                margin-top: 0.5rem;
                margin-bottom: 1.5rem;
            }
        }
    </style>
</head>

<body>
    <div class="animated-bg">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
    </div>

    <div class="scanlines"></div>

    <div class="container">
        <div class="error-code">
            <%= code || '404' %>
        </div>

        <h1 class="error-title"><span class="glitch-text">
                <%= title || 'Not found' %>
            </span></h1>

        <p class="error-message">
            <%= message || 'An error occurred' %>
        </p>

        <div class="button-group">
            <a href="/" class="btn-primary">← Back to Home</a>
            <a href="/auth/login" class="btn-secondary">Sign In</a>
        </div>
    </div>

    <script>
        // Add some interactive glitch effect on hover
        document.addEventListener('mousemove', (e) => {
            const errorCode = document.querySelector('.error-code');
            if (errorCode) {
                const x = (e.pageX - window.innerWidth / 2) * 0.01;
                const y = (e.pageY - window.innerHeight / 2) * 0.01;
                errorCode.style.transform = `perspective(1000px) rotateX(${y}deg) rotateY(${x}deg)`;
            }
        });
    </script>
</body>

</html>